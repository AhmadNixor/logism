    <comp lib="0" loc="40,-700" name="Text">
      <a name="text" val="8-BIT ALU  -  every gate built from transistors (NOT/NAND/NOR), composed hierarchically"/>
    </comp>
    <comp lib="0" loc="40,-670" name="Text">
      <a name="text" val="Direct one-hot select lines (assert exactly ONE):"/>
    </comp>
    <comp lib="0" loc="40,-640" name="Text">
      <a name="text" val="selADD  selSUB  selAND  selXOR  selLSH  selRSH   -&gt;  one-hot mux relays the chosen result"/>
    </comp>
    <comp lib="0" loc="40,-610" name="Text">
      <a name="text" val="A0..A7 / B0..B7 = operand bits (A0=LSB);  R0..R7 = result;  Cout = adder carry (ADD/SUB)"/>
    </comp>
